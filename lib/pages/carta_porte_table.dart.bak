                                      telController.text =
                                          choferes[i]['telefono'] ?? '';
                                      licenciaController.text =
                                          choferes[i]['licencia'] ?? '';
                                      editIndex = i;
                                      setStateDialog(() {});
                                    },
                                  ),
                                  IconButton(
                                    icon: const Icon(Icons.delete,
                                        color: Colors.red),
                                    onPressed: () async {
                                      await FirebaseFirestore.instance
                                          .collection('choferes')
                                          .doc(choferes[i].id)
                                          .delete();
                                    },
                                  ),
                                ],
                              ),
